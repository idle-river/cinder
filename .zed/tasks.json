[
  {
    // Runs the db studio for GUI access to the DB
    "label": "Database Studio",
    "command": "bun db:studio",
    "cwd": "$ZED_WORKTREE_ROOT/apps/server",
  },
  {
    // Runs the app in development
    "label": "Run App in Development",
    "command": "bun dev",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // Runs Docker Compose (DEVELOPMENT)
    "label": "Docker Compose DB + S3",
    "command": "podman compose up postgres rustfs rustfs-init",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
