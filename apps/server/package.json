{
  "name": "@cinder/server",
  "version": "1.0.50",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "bun --env-file=../../.env --env-file=.env src/index.ts",
    "dev": "bun --env-file=../../.env --env-file=.env --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx auth generate --output lib/db/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "better-auth": "1.7.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.20.0",
    "postgres": "^3.4.9"
  },
  "module": "src/index.js"
}
